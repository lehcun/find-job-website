// Prisma schema for job platform (candidates + employers + admin)
// Provider: MySQL (adjust datasource URL in .env)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- Enums ---
// (Các Enums này hoạt động tốt. MySQL sẽ tạo các cột kiểu ENUM cho chúng)

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  TEMPORARY
}

enum EmploymentType {
  ONSITE
  REMOTE
  HYBRID
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

enum ReviewTarget {
  COMPANY
  CANDIDATE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AdType {
  LISTING_BOOST
  BANNER
  FEATURED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

// --- Models ---

model User {
  id             String   @id @default(cuid())
  role           Role     @default(CANDIDATE)
  email          String?  @unique
  phone          String?  @unique
  passwordHash   String? // null for social accounts
  socialProvider String?
  socialId       String?
  name           String?
  avatarUrl      String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // relations
  candidateProfile CandidateProfile?
  employerProfile  EmployerProfile?

  // Loại bỏ postedJobs khỏi User nếu muốn Job liên kết trực tiếp với EmployerProfile
  // postedJobs       Job[] @relation("EmployerJobs") 

  applications    Application[]
  portfolios      Portfolio[]
  reviewsGiven    Review[]       @relation("GivenReviews")
  reviewsReceived Review[]       @relation("ReceivedReviews")
  notifications   Notification[]
  payments        Payment[]
  ads             AdCampaign[]
  interviews      Interview[]    @relation("InterviewParticipants")
  auditLogs       AuditLog[]
  reviewReports   ReviewReport[]
}

model CandidateProfile {
  id                String             @id @default(cuid())
  user              User               @relation(fields: [userId], references: [id])
  userId            String             @unique
  headline          String?
  location          String?
  salaryExpectation Decimal?           @db.Decimal(12, 2)
  skills            Skill[]            @relation("CandidateSkills")
  experiences       Json? // array of experiences
  educations        Json?
  portfolio         Portfolio[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  applications      Application[]
  courseEnrollments CourseEnrollment[]
}

model EmployerProfile {
  id          String  @id @default(cuid())
  user        User    @relation(fields: [userId], references: [id])
  userId      String  @unique
  companyName String
  companySize String?
  website     String?
  location    String?
  description String?

  // Jobs liên kết với EmployerProfile (Đã chỉnh tên quan hệ)
  postedJobs Job[] @relation("EmployerProfileJobs")

  adCampaigns AdCampaign[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Skill {
  id         String             @id @default(cuid())
  name       String             @unique
  jobs       Job[]              @relation("JobSkills")
  candidates CandidateProfile[] @relation("CandidateSkills")
}

model Job {
  id String @id @default(cuid())

  // Khóa ngoại và quan hệ trỏ đến EmployerProfile (Đã chỉnh tên quan hệ)
  employer   EmployerProfile @relation("EmployerProfileJobs", fields: [employerId], references: [id])
  employerId String

  title          String
  slug           String         @unique
  description    String
  location       String?
  minSalary      Decimal?       @db.Decimal(12, 2)
  maxSalary      Decimal?       @db.Decimal(12, 2)
  currency       String?        @default("VND")
  jobType        JobType
  employmentType EmploymentType
  isPublic       Boolean        @default(true)
  status         String         @default("OPEN")
  postedAt       DateTime       @default(now())
  expiresAt      DateTime?
  skills         Skill[]        @relation("JobSkills")
  requirements   Json?
  applications   Application[]
  viewsCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([slug])
}

// ... giữ nguyên các model còn lại
// ...

// Thêm lại các model còn lại để đảm bảo tính hoàn chỉnh
model Application {
  id          String            @id @default(cuid())
  job         Job               @relation(fields: [jobId], references: [id])
  jobId       String
  candidate   CandidateProfile  @relation(fields: [candidateId], references: [id])
  candidateId String
  coverLetter String?
  resumeUrl   String?
  status      ApplicationStatus @default(APPLIED)
  readAt      DateTime?
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  reviews     Review[]
  interview   Interview?
  user        User?             @relation(fields: [userId], references: [id])
  userId      String?

  @@index([jobId, candidateId])
}

model Portfolio {
  id          String           @id @default(cuid())
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id])
  candidateId String
  title       String
  summary     String?
  items       PortfolioItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User?            @relation(fields: [userId], references: [id])
  userId      String?
}

model PortfolioItem {
  id          String    @id @default(cuid())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
  portfolioId String
  title       String
  description String?
  mediaUrl    String?
  link        String?
  tag         String?
}

model Course {
  id          String             @id @default(cuid())
  title       String
  provider    String?
  description String?
  content     Json? // modules, lessons
  price       Decimal?           @db.Decimal(12, 2)
  certificate Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  enrollments CourseEnrollment[]
}

model CourseEnrollment {
  id          String           @id @default(cuid())
  course      Course           @relation(fields: [courseId], references: [id])
  courseId    String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id])
  candidateId String
  progress    Int              @default(0) // percent
  completedAt DateTime?
  enrolledAt  DateTime         @default(now())
}

model Review {
  id            String         @id @default(cuid())
  author        User           @relation("GivenReviews", fields: [authorId], references: [id])
  authorId      String
  targetUser    User           @relation("ReceivedReviews", fields: [targetUserId], references: [id])
  targetUserId  String
  targetType    ReviewTarget
  rating        Int            @default(5)
  title         String?
  body          String?
  criteria      Json? // e.g. {"on_time": true, "professional": true}
  createdAt     DateTime       @default(now())
  reports       ReviewReport[]
  application   Application?   @relation(fields: [applicationId], references: [id])
  applicationId String?
}

model ReviewReport {
  id         String   @id @default(cuid())
  review     Review   @relation(fields: [reviewId], references: [id])
  reviewId   String
  reporter   User     @relation(fields: [reporterId], references: [id])
  reporterId String
  reason     String
  createdAt  DateTime @default(now())
}

model Notification {
  id        String              @id @default(cuid())
  user      User                @relation(fields: [userId], references: [id])
  userId    String
  channel   NotificationChannel
  title     String
  body      String
  data      Json?
  read      Boolean             @default(false)
  createdAt DateTime            @default(now())
}

model Interview {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String      @unique
  scheduledAt   DateTime
  location      String? // url or place
  durationMins  Int?
  participants  User[]      @relation("InterviewParticipants")
  status        String?     @default("SCHEDULED")
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Payment {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("VND")
  status    PaymentStatus @default(PENDING)
  method    String?
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model AdCampaign {
  id          String          @id @default(cuid())
  employer    EmployerProfile @relation(fields: [employerId], references: [id])
  employerId  String
  type        AdType
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  budget      Decimal?        @db.Decimal(12, 2)
  stats       Json?
  histories   AdHistory[]
  createdAt   DateTime        @default(now())
  user        User?           @relation(fields: [userId], references: [id])
  userId      String?
}

model AdHistory {
  id          String     @id @default(cuid())
  campaign    AdCampaign @relation(fields: [campaignId], references: [id])
  campaignId  String
  date        DateTime
  impressions Int        @default(0)
  clicks      Int        @default(0)
  cost        Decimal?   @db.Decimal(12, 2)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  resource  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
}

// Simple system settings / CMS
model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json?
}
